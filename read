<div style="color:#0a0a0a;margin-left:0cm;margin-right:0cm;"><span style="background-color:#f0f2f5;color:#9334e6;">val</span><span style="background-color:#f0f2f5;"> magnitudes = calcularMagnitudes(audioData) </span></div>


<div style="color:#0a0a0a;margin-left:0cm;margin-right:0cm;"><span style="background-color:#f0f2f5;color:#80868b;">''// Transforma em bytes e envia via UDP''</span></div>

<div style="color:#0a0a0a;margin-left:0cm;margin-right:0cm;"><span style="background-color:#f0f2f5;color:#9334e6;">val</span><span style="background-color:#f0f2f5;"> packet = DatagramPacket(magnitudes, magnitudes.size, monitorAddress, </span><span style="background-color:#f0f2f5;color:#b45908;">5000</span><span style="background-color:#f0f2f5;">)</span></div>

<div style="color:#0a0a0a;"><span style="background-color:#f0f2f5;">udpSocket.send(packet)</span></div>

