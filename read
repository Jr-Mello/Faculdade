<div style="color:#0a0a0a;margin-left:0cm;margin-right:0cm;"><span style="background-color:#f0f2f5;color:#80868b;">''// Dentro de uma thread separada para não travar o app''</span></div>

<div style="color:#0a0a0a;margin-left:0cm;margin-right:0cm;"><span style="background-color:#f0f2f5;color:#9334e6;">val</span><span style="background-color:#f0f2f5;"> </span><span style="background-color:#f0f2f5;color:#b45908;">fftBuffer</span><span style="background-color:#f0f2f5;"> = FloatArray(</span><span style="background-color:#f0f2f5;color:#b45908;">1024</span><span style="background-color:#f0f2f5;">) </span></div>

<div style="color:#0a0a0a;margin-left:0cm;margin-right:0cm;"><span style="background-color:#f0f2f5;color:#9334e6;">val</span><span style="background-color:#f0f2f5;"> </span><span style="background-color:#f0f2f5;color:#b45908;">udpSocket</span><span style="background-color:#f0f2f5;"> = DatagramSocket()</span></div>

<div style="color:#0a0a0a;margin-left:0cm;margin-right:0cm;"><span style="background-color:#f0f2f5;color:#9334e6;">val</span><span style="background-color:#f0f2f5;"> </span><span style="background-color:#f0f2f5;color:#b45908;">monitorAddress</span><span style="background-color:#f0f2f5;"> = InetAddress.getByName(</span><span style="background-color:#f0f2f5;color:#188038;">"192.168.88.10"</span><span style="background-color:#f0f2f5;">) </span><span style="background-color:#f0f2f5;color:#80868b;">''// IP do 17º (MikroTik)''</span></div>


<div style="color:#0a0a0a;margin-left:0cm;margin-right:0cm;"><span style="background-color:#f0f2f5;color:#9334e6;">while</span><span style="background-color:#f0f2f5;"> (monitorando) {</span></div>

<div style="color:#0a0a0a;margin-left:0cm;margin-right:0cm;"><span style="background-color:#f0f2f5;color:#9334e6;">val</span><span style="background-color:#f0f2f5;"> audioData = recorder.read() </span><span style="background-color:#f0f2f5;color:#80868b;">''// Captura áudio''</span></div>

<div style="color:#0a0a0a;margin-left:0cm;margin-right:0cm;"><span style="background-color:#f0f2f5;">fft.realForward(audioData) </span><span style="background-color:#f0f2f5;color:#80868b;">''// Executa a FFT''</span></div>


